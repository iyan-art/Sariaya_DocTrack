# Copy this file to `.env` in the same directory (backend/.env) and fill in
# real values to enable actual email delivery. `.env` is gitignored — never
# commit real credentials. Leaving EMAIL_HOST_USER/EMAIL_HOST_PASSWORD blank
# (or omitting this file entirely) falls back to the console email backend —
# every "sent" email just prints to the runserver terminal, nothing is
# actually delivered.

# --- Gmail SMTP (recommended) ---
# 1. On the sending Gmail account: Google Account -> Security -> 2-Step
#    Verification -> turn it on (required before App Passwords are offered).
# 2. Google Account -> Security -> App passwords -> create one for "Mail".
# 3. Paste the 16-character App Password below (NOT the normal Gmail login
#    password — that will not work with SMTP).
EMAIL_HOST_USER=your-office-account@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true

# What citizens/staff see in the "From" field. Defaults to EMAIL_HOST_USER
# if left unset.
DEFAULT_FROM_EMAIL=your-office-account@gmail.com
