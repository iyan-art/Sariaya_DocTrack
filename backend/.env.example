# Local development values. In production, set these in Render's Environment
# settings instead (with DEBUG=False and your real hostnames).
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_BASE_URL=http://localhost:5173

# Leave unset to use the local db.sqlite3.
# DATABASE_URL=postgres://user:password@host:5432/dbname

EMAIL_HOST_USER=your-office-account@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true

DEFAULT_FROM_EMAIL=your-office-account@gmail.com
