        {
          "key": "mother_maiden_name",
          "label": "Mother's Maiden Name",
          "type": "text",
          "required": true
        },
        {
          "key": "father_full_name",
          "label": "Father's Full Name",
          "type": "text",
          "required": false
        },
        {
          "key": "requestor_relationship",
          "label": "Relationship to the Child",
          "type": "select",
          "required": true,
          "options": [
            "Self",
            "Parent",
            "Sibling",
            "Spouse",
            "Child",
            "Authorized Representative",
            "Other"
          ]
        },
        {
          "key": "purpose",
          "label": "Purpose",
          "type": "select",
          "required": true,
          "options": [
            "Employment",
            "School / Enrollment",
            "Passport Application",
            "Travel",
            "Government Transaction",
            "Other"
          ]
        },
        {
          "key": "number_of_copies",
          "label": "Number of Copies",
          "type": "number",
          "required": true,
          "placeholder": "1"
        },
        {
          "key": "contact_no",
          "label": "Contact Number",
          "type": "tel",
          "required": true
        }
      ],
      "is_active": true,
      "steps": [
        {
          "step_number": 1,
          "office": "MCRO",
