          "type": "text",
          "required": true
        },
        {
          "key": "date_of_birth",
          "label": "Date of Birth",
          "type": "date",
          "required": true
        },
        {
          "key": "place_of_birth",
          "label": "Place of Birth",
          "type": "text",
          "required": true,
          "placeholder": "Hospital / City"
