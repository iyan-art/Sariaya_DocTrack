    {
      "name": "Payroll",
      "scope": "internal",
      "description": "Internal payroll processing document",
      "daily_limit": null,
      "request_fields": [
        {
          "key": "pay_period",
          "label": "Pay Period",
          "type": "text",
          "required": true,
          "placeholder": "e.g. August 1-15, 2026"
        },
        {
          "key": "department",
          "label": "Department",
          "type": "text",
          "required": true
        },
        {
          "key": "remarks",
          "label": "Remarks",
          "type": "textarea",
          "required": false
        }
      ],
      "is_active": true,
      "steps": [
        {
          "step_number": 1,
          "office": "HRMO",
          "action_required": "Collects all Daily Time Records (DTRs), biometric logs, approved leave forms, and official business travel orders from all departments.",
          "max_hours_allowed": 24
        },
        {
          "step_number": 2,
          "office": "BAC",
          "action_required": "reviews the total payroll cost against the LGU's current funds.",
          "max_hours_allowed": 24
        },
        {
          "step_number": 3,
          "office": "MAO",
          "action_required": "conducts a pre-audit of the payroll",
          "max_hours_allowed": 24
        },
        {
          "step_number": 4,
          "office": "MAYOR",
          "action_required": "The compiled payroll bundle is forwarded to the executive suite for final executive authorization.",
          "max_hours_allowed": 24
        },
        {
          "step_number": 5,
          "office": "MTO",
          "action_required": "checks if there is actual cash available in the municipal bank account to cover the total amount.",
          "max_hours_allowed": 24
        }
      ]
    },
